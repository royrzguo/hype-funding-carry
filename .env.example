HFC_ACCOUNT_ADDRESS="<hypercore-account-address>"
HFC_AGENT_ADDRESS="<api-agent-address>"
HFC_CONFIG_PATH=config/strategy.example.json
HFC_PRIVATE_KEY_FILE="<path-to-local-agent-key>"
HFC_STATE_DIR=state
